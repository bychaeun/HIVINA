---
import '../styles/global.css';
import CanvasChrome from '../components/CanvasChrome.astro';
import { COMPANY, HTML_LANG, LANGS, type Lang } from '../config/site';
import { swapLang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 홈처럼 페이지 맨 위가 어두운 히어로일 때 true */
  overDark?: boolean;
}

const { lang, title, description = '', overDark = false } = Astro.props;
const fullTitle = title ? `${title} | ${COMPANY.name}` : COMPANY.name;
const site = Astro.site;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#04301c" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      site &&
        LANGS.map((l) => (
          <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(swapLang(Astro.url.pathname, l), site)} />
        ))
    }
    <!-- 스크립트가 켜져 있을 때만 등장 모션용으로 요소를 숨김 (꺼져 있으면 그냥 보임) -->
    <script is:inline>document.documentElement.classList.add('js');if(new URLSearchParams(location.search).get('modal')==='1')document.documentElement.classList.add('is-design-modal');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&display=swap"
    />
    {
      lang === 'ko' && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
        />
      )
    }
    <link rel="stylesheet" href="/home/refinements.css" />
    <link rel="stylesheet" href="/home/chrome.css" />
    <link rel="stylesheet" href="/home/detail-theme.css" />
    <link rel="stylesheet" href="/home/design-modal.css" />
  </head>
  <body class="detail-shell">
    <CanvasChrome lang={lang} />
    <main id="top" class:list={{ 'header-offset': !overDark }}>
      <slot />
    </main>
    <CanvasChrome lang={lang} part="footer" />
    <script>
      import '../scripts/motion.ts';
    </script>
    <script is:inline src="/home/refinements.js" defer></script>
    <script is:inline src="/home/design-modal.js" defer></script>
  </body>
</html>
