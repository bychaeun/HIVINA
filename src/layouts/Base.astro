---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, langs, type Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.meta.title}</title>
    <meta name="description" content={d.meta.description} />
    <meta name="theme-color" content="#0e3b2c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {langs.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(path.replace(/^\/(ko|vi|en)\//, `/${l}/`), Astro.site)} />
    ))}
    <meta property="og:title" content={d.meta.title} />
    <meta property="og:description" content={d.meta.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
