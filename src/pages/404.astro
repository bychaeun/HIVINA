---
import Base from '../layouts/Base.astro';
import { DEFAULT_LANG } from '../config/site';
import { useT } from '../i18n/ui';
import { href } from '../i18n/utils';

const lang = DEFAULT_LANG;
const t = useT(lang);
---

<Base lang={lang} title="404">
  <section class="section">
    <div class="container">
      <h1>404 · {t('notFound.title')}</h1>
      <p><a class="btn" href={href(lang)}>{t('notFound.back')}</a></p>
    </div>
  </section>
</Base>
