---
/**
 * 루트(/)의 첫 화면은 베트남어입니다. 언어 선택 후에는 선택한 URL을 사용합니다.
 */
import { DEFAULT_LANG } from '../config/site';
const fallback = `/${DEFAULT_LANG}/`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HIVINA</title>
    <meta http-equiv="refresh" content={`1; url=${fallback}`} />
    <link rel="canonical" href={fallback} />
    <script is:inline define:vars={{ fallback }}>
      location.replace(fallback + location.search + location.hash);
    </script>
  </head>
  <body>
    <p><a href={fallback}>HIVINA</a></p>
  </body>
</html>
