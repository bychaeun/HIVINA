---
// 디자인 캔버스에서 옮긴 화면입니다. 마크업은 src/site/contact/<언어>.html 을 수정하세요.
import CanvasPage from '../../components/CanvasPage.astro';
import ko from '../../site/contact/ko.html?raw';
import en from '../../site/contact/en.html?raw';
import vi from '../../site/contact/vi.html?raw';
import type { Lang } from '../../config/site';
import { langPaths } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const html = { ko, en, vi }[lang];
const title = {"ko": "문의하기", "en": "Contact us", "vi": "Liên hệ"};
const description = {"ko": "HIVINA JSC 문의 및 위치 안내.", "en": "Contact HIVINA JSC and find our location.", "vi": "Liên hệ HIVINA JSC và vị trí công ty."}[lang];
---

<CanvasPage lang={lang} html={html} css="contact" title={title ? title[lang] : undefined} description={description} />
