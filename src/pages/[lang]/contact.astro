---
import Base from '../../layouts/Base.astro';
import { COMPANY, type Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
import { langPaths } from '../../i18n/utils';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const q = encodeURIComponent(COMPANY.mapQuery);
const mapEmbed = `https://www.google.com/maps?q=${q}&hl=${lang}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${q}`;
---

<Base lang={lang} title={t('contact.title')} description={t('contact.lead')}>
  <section class="page-head">
    <div class="container">
      <h1>{t('contact.title')}</h1>
      <p class="lead">{t('contact.lead')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <dl class="info">
        <dt>{t('contact.address')}</dt>
        <dd>{COMPANY.address[lang]}<br /><a href={mapLink} target="_blank" rel="noopener">{t('contact.map')} ↗</a></dd>
        <dt>{t('contact.phone')}</dt>
        <dd><a href={`tel:${COMPANY.phone.replace(/\s/g, '')}`}>{COMPANY.phone}</a></dd>
        <dt>{t('contact.fax')}</dt>
        <dd>{COMPANY.fax}</dd>
        {
          COMPANY.email && (
            <>
              <dt>{t('contact.email')}</dt>
              <dd><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></dd>
            </>
          )
        }
      </dl>
      <iframe class="map" src={mapEmbed} title={t('contact.map')} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(28px, 5vw, 56px);
  }
  dt {
    font-weight: 600;
    color: var(--color-primary);
    font-size: 0.9rem;
  }
  dd {
    margin: 4px 0 24px;
  }
  .map {
    width: 100%;
    min-height: 360px;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
