---
import Base from '../../layouts/Base.astro';
import SourceImage from '../../components/SourceImage.astro';
import { COPY,source } from '../../data/website';
import type { Lang } from '../../config/site';
import { href,langPaths } from '../../i18n/utils';
export const getStaticPaths=langPaths;
const lang=Astro.params.lang as Lang,c=COPY[lang];
const groups=['wood','solid','fabric','stone','tambour-board'] as const;
const searchCopy={ko:{label:'제품 번호 검색',placeholder:'제품 번호 검색 · 예: HI 6000 / 901',clear:'검색 지우기',empty:'검색 결과가 없습니다.'},en:{label:'Search product number',placeholder:'Search product number · e.g. HI 6000 / 901',clear:'Clear search',empty:'No matching products.'},vi:{label:'Tìm mã sản phẩm',placeholder:'Tìm mã sản phẩm · VD: HI 6000 / 901',clear:'Xóa tìm kiếm',empty:'Không tìm thấy sản phẩm.'}}[lang];
---
<Base lang={lang} title={c.collection} description={c.browse}>
<header class="page-head"><div class="container"><p class="micro">HIVINA / DESIGN LIBRARY</p><h1>{c.collection}</h1><p class="lead">{c.browse}</p></div></header>
<section class="container section catalogue" data-catalogue>
  <div class="catalogue-toolbar">
    <nav class="filters" aria-label={c.collection}><button type="button" data-group="all" aria-pressed="true">{c.filterAll}</button>{groups.map(g=><button type="button" data-group={g} aria-pressed="false">{c.groups[g]}</button>)}</nav>
    <form class="product-search" role="search" data-catalogue-search>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
      <label class="sr-only" for="catalogue-number">{searchCopy.label}</label>
      <input id="catalogue-number" name="q" type="search" placeholder={searchCopy.placeholder} autocomplete="off"/>
      <button type="button" data-search-clear aria-label={searchCopy.clear} hidden>×</button>
    </form>
  </div>
  <div class="catalogue-meta"><span>{c.patterns}</span><span data-catalogue-count aria-live="polite">{source.decors.length}</span></div>
  <div class="design-grid">{source.decors.map((decor,i)=><a class="design-card" data-decor-group={decor.group} data-product-number={decor.name} data-index={i} href={href(lang,`/design/${decor.slug}`)}><div><SourceImage file={decor.image} alt={decor.name} width={600} height={600}/><span aria-hidden="true">↗</span></div><p>{decor.name}<small>{c.groups[decor.group as keyof typeof c.groups]}</small></p></a>)}</div>
  <p data-catalogue-empty hidden role="status">{searchCopy.empty}</p>
  <nav class="pagination" aria-label={c.collection}><button type="button" data-page-step="-1" aria-label={lang==='ko'?'이전 페이지':lang==='vi'?'Trang trước':'Previous page'}>←</button><span data-page-status aria-live="polite"></span><button type="button" data-page-step="1" aria-label={lang==='ko'?'다음 페이지':lang==='vi'?'Trang tiếp theo':'Next page'}>→</button></nav>
</section>
</Base>
<script>
 const root=document.querySelector<HTMLElement>('[data-catalogue]');
 if(root){
  const cards=[...root.querySelectorAll<HTMLElement>('[data-decor-group]')];const filters=[...root.querySelectorAll<HTMLButtonElement>('[data-group]')];const steps=[...root.querySelectorAll<HTMLButtonElement>('[data-page-step]')];
  const search=root.querySelector<HTMLFormElement>('[data-catalogue-search]')!,input=search.querySelector<HTMLInputElement>('input')!,clear=search.querySelector<HTMLButtonElement>('[data-search-clear]')!;
  const normalize=(value:string)=>value.toLowerCase().replace(/[^a-z0-9]/g,'');
  let group='all',page=1;const pageSize=25;
  function apply(sync=true,scroll=false){const term=normalize(input.value);clear.hidden=!input.value;const matches=cards.filter(card=>(group==='all'||card.dataset.decorGroup===group)&&normalize(card.dataset.productNumber||'').includes(term));root!.querySelector<HTMLElement>('[data-catalogue-empty]')!.hidden=matches.length>0;root!.querySelector<HTMLElement>('.pagination')!.hidden=matches.length<=pageSize;const pages=Math.max(1,Math.ceil(matches.length/pageSize));page=Math.max(1,Math.min(page,pages));const visible=new Set(matches.slice((page-1)*pageSize,page*pageSize));cards.forEach(card=>{card.hidden=!visible.has(card);const link=card as HTMLAnchorElement;const destination=new URL(link.href);destination.searchParams.set('group',card.dataset.decorGroup||group);destination.searchParams.set('page',String(page));link.href=destination.href;});filters.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.group===group)));root!.querySelector('[data-catalogue-count]')!.textContent=String(matches.length);root!.querySelector('[data-page-status]')!.textContent=`${String(page).padStart(2,'0')} / ${String(pages).padStart(2,'0')}`;steps.forEach(button=>button.disabled=Number(button.dataset.pageStep)<0?page===1:page===pages);if(sync){const url=new URL(location.href);if(group==='all')url.searchParams.delete('group');else url.searchParams.set('group',group);if(input.value.trim())url.searchParams.set('q',input.value.trim());else url.searchParams.delete('q');if(page===1)url.searchParams.delete('page');else url.searchParams.set('page',String(page));history.replaceState(history.state,'',url);}if(scroll)window.scrollTo({top:root!.getBoundingClientRect().top+window.scrollY-100,behavior:'instant'});}
  function read(){const params=new URLSearchParams(location.search);input.value=params.get('q')||'';const requested=params.get('group')||'all';group=filters.some(f=>f.dataset.group===requested)?requested:'all';page=Math.max(1,Number(params.get('page'))||1);apply(false);}
  search.addEventListener('submit',event=>{event.preventDefault();page=1;apply();});input.addEventListener('input',()=>{page=1;apply();});clear.addEventListener('click',()=>{input.value='';page=1;apply();input.focus();});
  filters.forEach(button=>button.addEventListener('click',()=>{group=button.dataset.group||'all';page=1;apply();}));steps.forEach(button=>button.addEventListener('click',()=>{page+=Number(button.dataset.pageStep);apply(true,true);}));window.addEventListener('popstate',read);window.addEventListener('pageshow',read);read();
 }
</script>
<style>
.catalogue-toolbar{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-bottom:20px;border-bottom:1px solid var(--color-line)}.catalogue-toolbar .filters{border:0;padding-bottom:0}.catalogue-toolbar .product-search{margin-left:auto;flex:none;width:360px}.pagination[hidden]{display:none}@media(max-width:1100px){.catalogue-toolbar{flex-wrap:wrap}.catalogue-toolbar .product-search{margin-left:0;width:100%;max-width:none;flex-basis:100%}}

.filters{display:flex;flex-wrap:wrap;gap:10px;border-bottom:1px solid var(--color-line);padding-bottom:20px;}.filters button{font:inherit;font-size:12px;padding:10px 20px;border:1px solid var(--color-line);border-radius:30px;background:transparent;color:var(--ink-soft);cursor:pointer;}.filters button[aria-pressed='true']{background:var(--brand-deep);border-color:var(--brand-deep);color:#fff;}.catalogue-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-soft);padding-block:22px;}.design-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:32px 22px;}.design-card{text-decoration:none;}.design-card[hidden]{display:none;}.design-card>div{position:relative;aspect-ratio:1;overflow:hidden;border-radius:12px;background:#e5e8e1;}.design-card :global(img){width:100%;height:100%;object-fit:cover;transition:transform .7s var(--ease);}.design-card:hover :global(img){transform:scale(1.04);}.design-card>div>span{position:absolute;right:14px;bottom:14px;width:30px;height:30px;border-radius:50%;background:rgb(255 255 255 / .85);display:grid;place-items:center;font-size:14px;}.design-card p{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin:12px 0 0;}.design-card small{font-size:10px;color:var(--ink-soft);}.pagination{display:flex;justify-content:center;align-items:center;gap:24px;margin-top:48px;font-size:11px;}.pagination button{width:36px;height:36px;border:1px solid var(--color-line);border-radius:50%;background:var(--brand-deep);color:#fff;cursor:pointer;}.pagination button:disabled{background:transparent;color:#9aa39c;cursor:default;}@media(max-width:900px){.design-grid{grid-template-columns:repeat(3,minmax(0,1fr));}}@media(max-width:600px){.design-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 14px;}.filters{gap:8px;}.filters button{font-size:11px;padding:9px 14px;}.design-card small{display:none;}}
</style>
