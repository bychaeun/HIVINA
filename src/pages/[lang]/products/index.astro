---
// 디자인 캔버스에서 옮긴 화면입니다. 마크업은 src/site/products/<언어>.html 을 수정하세요.
import CanvasPage from '../../../components/CanvasPage.astro';
import ko from '../../../site/products/ko.html?raw';
import en from '../../../site/products/en.html?raw';
import vi from '../../../site/products/vi.html?raw';
import type { Lang } from '../../../config/site';
import { langPaths } from '../../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const html = { ko, en, vi }[lang];
const title = {"ko": "제품", "en": "Our product", "vi": "Sản phẩm"};
const description = {"ko": "LPM, 피니싱 포일, HPL, 템바보드 — 친환경 인테리어 마감재.", "en": "LPM, finishing foil, HPL and tambour board — eco-friendly interior materials.", "vi": "LPM, finishing foil, HPL và tấm tambour — vật liệu nội thất thân thiện môi trường."}[lang];
---

<CanvasPage lang={lang} html={html} css="products" title={title ? title[lang] : undefined} description={description} model />
