---
import Base from '../../../layouts/Base.astro';
import SourceImage from '../../../components/SourceImage.astro';
import { getImage } from 'astro:assets';
import { LANGS,type Lang } from '../../../config/site';
import { COPY,source,sourceImage } from '../../../data/website';
import { href } from '../../../i18n/utils';
export function getStaticPaths(){return LANGS.flatMap(lang=>source.decors.map(decor=>({params:{lang,id:decor.slug},props:{slug:decor.slug}})));}
const lang=Astro.params.lang as Lang,c=COPY[lang];
const decor=source.decors.find(d=>d.slug===Astro.props.slug)!;
const isTambour=decor.group==='tambour-board';
const groupName=c.groups[decor.group as keyof typeof c.groups];
const related=source.decors.filter(d=>d.group===decor.group&&d.slug!==decor.slug).slice(0,18);
const asset=sourceImage(decor.image)!;
const preview=await getImage({src:asset,width:Math.min(asset.width,1800),format:'webp',quality:94});
const ui={ko:{save:'이미지 저장',zoom:'부분 확대',hint:'200% · 전체 이미지에서 마우스를 움직이거나 터치하세요',inspect:'200% 확대할 부분 선택'},en:{save:'Save image',zoom:'Material detail',hint:'200% · Move or tap on the full image',inspect:'Choose an area to inspect at 200%'},vi:{save:'Lưu hình ảnh',zoom:'Chi tiết vật liệu',hint:'200% · Di chuyển hoặc chạm vào ảnh đầy đủ',inspect:'Chọn vùng để xem ở mức 200%'}}[lang];
---
<Base lang={lang} title={decor.name} description={`${groupName} / ${decor.name}`}>
<section class="container section">
  <a data-catalogue-back class="micro back" href={`${href(lang,'/catalogue')}?group=${decor.group}`}>← {c.collection} / {groupName}</a>
  <div class="decor-layout">
    <div class:list={['decor-preview',{'plain':isTambour}]} data-magnifier tabindex={isTambour?undefined:'0'} role="group" aria-label={isTambour?decor.name:ui.inspect} style={`aspect-ratio:${preview.attributes.width}/${preview.attributes.height}`}>
      <img src={preview.src} width={preview.attributes.width} height={preview.attributes.height} alt={decor.name} loading="eager" decoding="async" />
      {!isTambour&&<span class="zoom-lens" aria-hidden="true"></span>}
    </div>
    <div class="decor-info">
      <p class="micro">{groupName} / HIVINA</p><h1>{decor.name}</h1>
      {!isTambour&&<div class="zoom-panel">
        <div class="zoom-panel-head"><span>{ui.zoom}</span><span class="zoom-ratio">200%</span><a class="save-image" href={preview.src} download={`${decor.slug}.webp`} aria-label={ui.save} title={ui.save}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 16v4h16v-4"/></svg></a></div>
        <div class="zoom-detail" data-zoom-detail role="img" aria-label={`${decor.name} · 200%`} style={`background-image:url('${preview.src}')`}></div>
      </div>}
    </div>
  </div>
  <section class="related" aria-label={c.related}>
    <h2>{c.related}</h2>
    <div class="related-window"><div class="related-track" style={`--drift-time:${Math.max(35,related.length*4)}s`}>
      {[false,true].map(copy=><div class="related-set" aria-hidden={copy?'true':undefined}>{related.map(item=><a class="related-card" href={`${href(lang,`/design/${item.slug}`)}?group=${decor.group}`} tabindex={copy?-1:undefined}><SourceImage file={item.image} alt={item.name} width={240} height={240}/><span>{item.name}<span aria-hidden="true">↗</span></span></a>)}</div>)}
    </div></div>
  </section>
</section>
</Base>
<script>
 const back=document.querySelector<HTMLAnchorElement>('[data-catalogue-back]');
 if(back){const query=new URLSearchParams(location.search);const group=query.get('group');const page=Math.max(1,Math.floor(Number(query.get('page'))||1));if(group&&['all','wood','solid','fabric','stone','tambour-board'].includes(group)){const url=new URL(back.href);if(group==='all')url.searchParams.delete('group');else url.searchParams.set('group',group);if(page>1)url.searchParams.set('page',String(page));back.href=url.href;}}
 const overview=document.querySelector<HTMLElement>('[data-magnifier]');
 const detail=document.querySelector<HTMLElement>('[data-zoom-detail]');
 const lens=overview?.querySelector<HTMLElement>('.zoom-lens');
 if(overview&&detail&&lens){
  let x=.5,y=.5;
  function show(nx:number,ny:number){
   const box=overview!.getBoundingClientRect(),dw=detail!.clientWidth,dh=detail!.clientHeight;
   if(!box.width||!box.height||!dw||!dh)return;
   // Exactly 2x the overview's rendered scale, even when the detail pane is smaller.
   const halfW=Math.min(.5,dw/(box.width*4)),halfH=Math.min(.5,dh/(box.height*4));
   x=Math.max(halfW,Math.min(1-halfW,nx));y=Math.max(halfH,Math.min(1-halfH,ny));
   detail!.style.backgroundSize=`${box.width*2}px ${box.height*2}px`;
   detail!.style.backgroundPosition=`${dw/2-x*box.width*2}px ${dh/2-y*box.height*2}px`;
   lens!.style.width=`${halfW*200}%`;lens!.style.height=`${halfH*200}%`;
   lens!.style.left=`${(x-halfW)*100}%`;lens!.style.top=`${(y-halfH)*100}%`;
  }
  function point(event:PointerEvent){const rect=overview!.getBoundingClientRect();show((event.clientX-rect.left)/rect.width,(event.clientY-rect.top)/rect.height);}
  overview.addEventListener('pointerdown',point);
  overview.addEventListener('pointermove',event=>{if(event.pointerType==='mouse'||event.buttons)point(event);});
  overview.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Home'].includes(event.key))return;event.preventDefault();if(event.key==='Home')show(.5,.5);else show(x+(event.key==='ArrowRight' ? .04 : event.key==='ArrowLeft' ? -.04 : 0),y+(event.key==='ArrowDown' ? .04 : event.key==='ArrowUp' ? -.04 : 0));});
  show(.5,.5);
  const resize=new ResizeObserver(()=>show(x,y));resize.observe(overview);resize.observe(detail);
 }
</script>
<style>
.back{display:inline-block;text-decoration:none;margin-bottom:30px}.decor-layout{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(32px,6vw,80px);align-items:start}.decor-preview{position:relative;border-radius:18px;overflow:hidden;background:#ecefe9;cursor:crosshair;touch-action:pan-y}.decor-preview>img{display:block;width:100%;height:100%;object-fit:contain}.decor-preview:focus-visible{outline:2px solid var(--brand-deep);outline-offset:4px}.zoom-lens{position:absolute;left:25%;top:25%;width:50%;height:50%;border:1px solid #fff;background:#ffffff20;box-shadow:0 0 0 1px #14201a40;pointer-events:none;opacity:0;transition:opacity .2s}.decor-preview:hover .zoom-lens,.decor-preview:focus .zoom-lens{opacity:1}.decor-info{padding-top:24px}.decor-info h1{font-size:clamp(32px,4vw,52px);font-weight:400}.decor-info>p:not(.micro){font-size:14px;color:var(--ink-soft);margin-bottom:30px}.zoom-panel{max-width:420px;margin-top:36px;background:#fff;border:1px solid var(--color-line);border-radius:16px;overflow:hidden}.zoom-panel-head{display:flex;align-items:center;gap:14px;padding:11px 16px;font-size:12px}.zoom-ratio{margin-left:auto;color:var(--ink-soft);font-size:11px}.save-image{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;color:var(--brand-deep)}.save-image:hover{background:#eef2ec}.save-image svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.zoom-detail{width:100%;aspect-ratio:1;background-repeat:no-repeat;background-size:200% 200%;background-position:50% 50%}.zoom-panel>p{padding:12px 16px;margin:0;color:var(--ink-soft);font-size:10px;line-height:1.5}.related{margin-top:64px;border-top:1px solid var(--color-line);padding-top:30px}.related h2{font-size:24px;font-weight:400}.related-window{overflow:hidden;container-type:inline-size;margin-top:24px}.related-track{display:flex;width:max-content;animation:related-drift var(--drift-time,50s) linear infinite}.related-set{display:flex;gap:18px;padding-right:18px}.related-card{display:block;flex:none;width:calc((100cqw - 90px)/6);font-size:11px;text-decoration:none}.related-card>span{display:flex;justify-content:space-between}.related :global(img){width:100%;aspect-ratio:1;object-fit:cover;border-radius:10px;margin-bottom:12px}.related-window:hover .related-track,.related-window:focus-within .related-track{animation-play-state:paused}@keyframes related-drift{to{transform:translateX(-50%)}}@media(max-width:900px){.related-card{width:calc((100cqw - 54px)/4)}}@media(max-width:760px){.decor-layout{grid-template-columns:1fr}.decor-info{padding-top:0}.zoom-panel{max-width:none}.related-card{width:calc((100cqw - 36px)/3)}}@media(prefers-reduced-motion:reduce){.related-track{animation:none}.related-window{overflow-x:auto}.related-set[aria-hidden="true"]{display:none}}
</style>
<style>
 .decor-layout{align-items:stretch}
 .decor-info{display:flex;flex-direction:column;min-height:0}
 .decor-info h1{font-size:clamp(28px,3.2vw,42px);margin:12px 0 24px}
 .zoom-panel{border:0;border-radius:0;background:transparent;margin-top:auto;overflow:visible}
 .zoom-panel-head{padding:0 0 12px;min-height:40px}
 .zoom-detail{border-radius:12px}
 @media(max-width:760px){.zoom-panel{margin-top:20px}}
</style>
