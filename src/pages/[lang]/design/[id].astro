---
import Base from '../../../layouts/Base.astro';
import SourceImage from '../../../components/SourceImage.astro';
import { LANGS,type Lang } from '../../../config/site';
import { COPY,source } from '../../../data/website';
import { href } from '../../../i18n/utils';
export function getStaticPaths(){return LANGS.flatMap(lang=>source.decors.map(decor=>({params:{lang,id:decor.slug},props:{slug:decor.slug}})));}
const lang=Astro.params.lang as Lang,c=COPY[lang];
const decor=source.decors.find(d=>d.slug===Astro.props.slug)!;
const groupName=c.groups[decor.group as keyof typeof c.groups];
const related=source.decors.filter(d=>d.group===decor.group&&d.slug!==decor.slug).slice(0,4);
---
<Base lang={lang} title={decor.name} description={`${groupName} / ${decor.name}`}>
<section class="container section"><a data-catalogue-back class="micro back" href={`${href(lang,'/catalogue')}?group=${decor.group}`}>← {c.collection} / {groupName}</a><div class="decor-layout"><div class="decor-preview"><SourceImage file={decor.image} alt={decor.name} width={1400} eager/></div><div class="decor-info"><p class="micro">{groupName} / HI VINA</p><h1>{decor.name}</h1><p>{c.coming}</p><a class="btn" href={`${href(lang,'/contact')}?product=${encodeURIComponent(decor.name)}`}>{c.contact}<span>↗</span></a></div></div><div class="related"><h2>{c.related}</h2><div>{related.map(item=><a href={href(lang,`/design/${item.slug}`)}><SourceImage file={item.image} alt={item.name} width={500} height={500}/><span>{item.name}</span></a>)}</div></div></section>
</Base>
<script>
 const back=document.querySelector<HTMLAnchorElement>('[data-catalogue-back]');
 if(back){const query=new URLSearchParams(location.search);const group=query.get('group');const page=Math.max(1,Math.floor(Number(query.get('page'))||1));if(group&&['all','wood','solid','fabric','stone','tambour-board'].includes(group)){const url=new URL(back.href);if(group==='all')url.searchParams.delete('group');else url.searchParams.set('group',group);if(page>1)url.searchParams.set('page',String(page));back.href=url.href;}}
</script>
<style>
.back{display:inline-block;text-decoration:none;margin-bottom:30px;}.decor-layout{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(32px,6vw,80px);align-items:start;}.decor-preview{border-radius:18px;overflow:hidden;background:#ecefe9;}.decor-preview :global(img){width:100%;max-height:650px;object-fit:contain;}.decor-info{padding-top:24px;}.decor-info h1{font-size:clamp(32px,4vw,52px);font-weight:400;}.decor-info>p:not(.micro){font-size:14px;color:var(--ink-soft);margin-bottom:30px;}.related{margin-top:64px;border-top:1px solid var(--color-line);padding-top:30px;}.related h2{font-size:24px;font-weight:400;}.related>div{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:24px;}.related a{font-size:12px;text-decoration:none;}.related :global(img){aspect-ratio:1;object-fit:cover;border-radius:10px;margin-bottom:12px;}@media(max-width:760px){.decor-layout{grid-template-columns:1fr;}.decor-info{padding-top:0;}.related>div{grid-template-columns:1fr 1fr;}}
</style>
