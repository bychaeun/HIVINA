---
/**
 * 홈 화면 — 섹션 순서를 바꾸거나 빼려면 아래 목록만 수정하면 됩니다.
 * 제품군·제품명·사진은 content/ 폴더의 CSV 와 사진에서 자동으로 채워집니다.
 */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import Marquee from '../../components/sections/Marquee.astro';
import About from '../../components/sections/About.astro';
import ProductLines from '../../components/sections/ProductLines.astro';
import Eco from '../../components/sections/Eco.astro';
import Family from '../../components/sections/Family.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import type { Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
import { langPaths } from '../../i18n/utils';
import { getCategories, getProducts } from '../../lib/products';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const [categories, products] = await Promise.all([getCategories(), getProducts()]);
---

<Base lang={lang} description={t('home.lead')} overDark>
  <Hero lang={lang} />
  <Marquee products={products} />
  <About lang={lang} />
  <ProductLines lang={lang} categories={categories.filter((c) => c.products.length)} />
  <Eco lang={lang} />
  <Family lang={lang} />
  <ContactCta lang={lang} />
</Base>
