---
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
import { href, langPaths, localize } from '../../i18n/utils';
import { getCategories } from '../../lib/products';
import ProductCard from '../../components/ProductCard.astro';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const categories = await getCategories();
---

<Base lang={lang} description={t('home.lead')}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1>{t('home.title')}</h1>
      <p class="lead">{t('home.lead')}</p>
      <div class="actions">
        <a class="btn" href={href(lang, '/products')}>{t('home.cta.products')}</a>
        <a class="btn btn--ghost" href={href(lang, '/contact')}>{t('home.cta.contact')}</a>
      </div>
    </div>
  </section>

  {
    categories.map((cat) => (
      <section class="section">
        <div class="container">
          <p class="eyebrow">{t('home.categories')}</p>
          <h2>{localize(cat, 'name', lang)}</h2>
          <p class="lead">{localize(cat, 'summary', lang)}</p>
          <div class="grid cards">
            {cat.products.map((p) => (
              <ProductCard product={p} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--surface">
    <div class="container about">
      <h2>{t('home.about.title')}</h2>
      <p class="lead">{t('about.body')}</p>
      <a class="btn btn--ghost" href={href(lang, '/about')}>{t('home.about.more')}</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(72px, 12vw, 152px) 0;
    background:
      linear-gradient(120deg, rgba(23, 58, 94, 0.06), rgba(168, 116, 63, 0.08)),
      var(--color-surface);
  }
  .hero h1 {
    font-size: clamp(2rem, 5.2vw, 3.5rem);
    white-space: pre-line;
    max-width: 18ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .cards {
    margin-top: 32px;
  }
  .about .btn {
    margin-top: 24px;
  }
</style>
