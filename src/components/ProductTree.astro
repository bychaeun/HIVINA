---
import { families,COPY,productNames } from '../data/website';
import type { Lang } from '../config/site';
import { href } from '../i18n/utils';
const {lang,current=''}=Astro.props as {lang:Lang;current?:string};const c=COPY[lang];
const special=families[0].children.filter(id=>!['standard-lpm','lpm-special'].includes(id));
const groupLinks=['wood','solid','fabric','stone'] as const;
---
<aside class="product-tree"><a class="tree-overview" href={href(lang,'/products')} aria-current={current===''?'page':undefined}>{c.products}<span>↗</span></a>{families.map(f=>f.children.length===0?<a class="family-single" href={href(lang,`/products/${f.id}`)} aria-current={f.id===current?'page':undefined}>{f.name}<span>↗</span></a>:<details open={f.id===current||f.children.includes(current)}><summary><a href={href(lang,`/products/${f.id}`)} aria-current={f.id===current?'page':undefined}>{f.name}</a><span aria-hidden="true">+</span></summary><ul>{(f.id==='lpm'?['standard-lpm','lpm-special']:f.children).map(id=><li><a href={href(lang,`/products/${id}`)} aria-current={id===current?'page':undefined}>{productNames[id]}</a>{id==='standard-lpm'&&<ul>{groupLinks.map(g=><li><a href={`${href(lang,'/catalogue')}?group=${g}`}>{c.groups[g]}</a></li>)}</ul>}{id==='lpm-special'&&<ul>{special.map(child=><li><a href={href(lang,`/products/${child}`)} aria-current={child===current?'page':undefined}>{productNames[child]}</a></li>)}</ul>}</li>)}</ul></details>)}<a class="tree-catalogue" href={href(lang,'/catalogue')}>{c.collection}<span>↗</span></a></aside>
<style>
.product-tree{position:sticky;top:calc(var(--header-h) + 28px);align-self:start;font-size:12px;max-height:calc(100svh - var(--header-h) - 50px);overflow:auto;scrollbar-width:thin;}.tree-overview{display:flex;justify-content:space-between;text-decoration:none;border-bottom:1px solid var(--color-line);padding:0 0 18px;margin-bottom:8px;font-size:11px;color:var(--ink-soft);}.product-tree details{border-bottom:1px solid var(--color-line);}.product-tree summary{display:flex;justify-content:space-between;gap:12px;list-style:none;cursor:pointer;padding:16px 0;}.product-tree summary::-webkit-details-marker{display:none;}.product-tree summary>a{text-decoration:none;flex:1;}.product-tree details[open]>summary>span{rotate:45deg;}.product-tree ul{list-style:none;margin:0;padding:0 0 12px 14px;border-left:1px solid var(--color-line);}.product-tree ul ul{margin:4px 0 10px;padding-bottom:0;}.product-tree li>a{display:block;padding:7px 0;text-decoration:none;color:var(--ink-soft);font-size:11px;}.product-tree ul ul a{font-size:10px;}.product-tree a[aria-current],.product-tree a:hover{color:var(--moss);font-weight:500;}.tree-catalogue{display:flex;justify-content:space-between;text-decoration:none;padding-top:22px;font-size:11px;}.family-single{display:flex;justify-content:space-between;padding:16px 0;text-decoration:none;border-bottom:1px solid var(--color-line);font-size:12px;}@media(max-width:900px){.product-tree{position:static;max-height:none;display:flex;flex-wrap:wrap;align-items:start;gap:12px;border-bottom:1px solid var(--color-line);padding-bottom:20px;overflow:visible;}.tree-overview{width:100%;margin:0;padding-bottom:12px;}.product-tree details{border:0;}.product-tree summary,.family-single{padding:8px 10px;border:1px solid var(--color-line);border-radius:4px;gap:12px;}.product-tree details>ul{padding-top:12px;}.tree-catalogue{padding:8px 0;font-size:11px;}}
</style>
