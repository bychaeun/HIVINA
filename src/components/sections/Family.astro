---
import { COMPANY, type Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const links = COMPANY.family.filter((f) => f.url);
---
<section class="family">
  <div class="container inner">
    <div class="roots" aria-hidden="true" data-reveal><span>HYOSAN <i>×</i> ICC</span><span class="connector"></span><b>HI VINA</b></div>
    <div>
      <span class="label" data-reveal>{t('home.family.label')}</span>
      <h2 class="h2" data-reveal style="--i:1">{t('home.family.title')}</h2>
      <p data-reveal style="--i:2">{t('home.family.body')}</p>
      <div class="links" data-reveal style="--i:3">{links.map((f) => <a class="editorial-link" href={f.url} target="_blank" rel="noopener">{f.name} <span aria-hidden="true">↗</span></a>)}</div>
    </div>
  </div>
</section>
<style>
  .family { padding: clamp(48px, 6vw, 80px) 0; }
  .inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 84px); align-items: center; }
  .roots { display: grid; justify-items: center; align-content: center; gap: 24px; min-height: 240px; background: #eceee8; }
  .roots > span:first-child { font-size: clamp(20px, 2.3vw, 30px); letter-spacing: .04em; font-weight: 400; }
  .roots i { font-size: 18px; font-style: normal; padding: 0 12px; color: #85968a; }
  .connector { height: 40px; width: 1px; background: #a4b3a7; }
  .roots b { font-size: 22px; font-weight: 500; letter-spacing: .15em; color: var(--moss); }
  .h2 { white-space: pre-line; margin-top: 6px; }
  p { color: var(--ink-soft); font-size: 14px; margin: 18px 0; max-width: 48ch; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 760px) { .inner { grid-template-columns: 1fr; } .roots { min-height: 190px; gap: 18px; } }
</style>
