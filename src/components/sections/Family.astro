---
import { t, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang).family;
const HYOSAN_URL = '#'; // TODO: 효산 홈페이지 주소
---
<section id="family" class="family">
  <div class="container inner">
    <div class="roots" aria-hidden="true" data-reveal>
      <span>HIVINA</span><i></i><span>HYOSAN</span>
    </div>
    <div>
      <span class="label" data-reveal>{d.label}</span>
      <h2 class="h2" data-reveal style="--i:1">{d.title}</h2>
      <p data-reveal style="--i:2">{d.body}</p>
      <a class="btn" data-reveal style="--i:3; --bg: var(--forest); --fg: var(--paper)" href={HYOSAN_URL}>{d.link} <span class="arrow">→</span></a>
    </div>
  </div>
</section>
<style>
  .family { padding: clamp(96px, 14vw, 180px) 0; }
  .inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .roots { position: relative; aspect-ratio: 1; display: grid; place-items: center; }
  .roots span { position: absolute; width: 58%; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; font-weight: 700; letter-spacing: .12em; font-size: clamp(14px, 1.6vw, 20px); }
  .roots span:first-child { left: 4%; padding-right: 22%; background: var(--forest); color: var(--leaf); animation: breathe 6s ease-in-out infinite alternate; }
  .roots span:last-of-type { right: 4%; padding-left: 22%; background: rgb(166 220 92 / .55); color: var(--forest); mix-blend-mode: multiply; animation: breathe 6s 3s ease-in-out infinite alternate; }
  @keyframes breathe { to { transform: scale(1.05); } }
  p { color: var(--ink-soft); font-size: clamp(16px, 1.4vw, 19px); margin: 24px 0 36px; max-width: 520px; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } .roots { max-width: 420px; width: 100%; } }
</style>
