---
/** 제품군 카드 — categories.csv 와 products.csv 에서 자동 생성. 대표 사진은 그 제품군 첫 제품의 사진. */
import { Image } from 'astro:assets';
import type { Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
import { href, localize } from '../../i18n/utils';
import type { Category } from '../../lib/products';

const { lang, categories } = Astro.props as { lang: Lang; categories: Category[] };
const t = useT(lang);
---

<section class="lines">
  <div class="container">
    <span class="label" data-reveal>{t('home.products.label')}</span>
    <h2 class="h2" data-reveal style="--i:1">{t('home.products.title')}</h2>
    <div class="cards">
      {
        categories.map((cat, i) => {
          const cover = cat.products.find((p) => p.images.length)?.images[0];
          const name = localize(cat, 'name', lang);
          return (
            <a class="card" href={`${href(lang, '/products')}#${cat.id}`} data-reveal style={`--i:${i}`}>
              <div class="visual">
                {cover && <Image src={cover} alt="" widths={[480, 960]} sizes="(max-width: 900px) 100vw, 50vw" />}
                <span class="no">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="text">
                <h3>{name}</h3>
                <p>{localize(cat, 'summary', lang)}</p>
                <ul>
                  {cat.products.map((p) => (
                    <li>{localize(p, 'name', lang)}</li>
                  ))}
                </ul>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .lines {
    padding: clamp(80px, 12vw, 160px) 0;
    background: var(--mist);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    margin-top: 56px;
  }
  .card {
    background: var(--color-card);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.7s var(--ease),
      box-shadow 0.7s var(--ease);
  }
  .card:hover {
    transform: translateY(-10px);
    box-shadow: 0 30px 60px -30px rgb(14 59 44 / 0.45);
  }
  .visual {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 80% 10%, var(--leaf), transparent 55%),
      linear-gradient(160deg, var(--moss), var(--forest));
  }
  .card:nth-child(2n) .visual {
    background:
      radial-gradient(120% 90% at 20% 0%, #7fd1c0, transparent 55%),
      linear-gradient(160deg, #2c6a62, var(--forest));
  }
  .visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .card:hover .visual :global(img) {
    transform: scale(1.05);
  }
  .no {
    position: absolute;
    left: 24px;
    bottom: 16px;
    color: var(--paper);
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-shadow: 0 2px 20px rgb(0 0 0 / 0.2);
  }
  .text {
    padding: 28px;
  }
  h3 {
    margin: 0 0 8px;
    font-size: 24px;
  }
  p {
    margin: 0;
    color: var(--ink-soft);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  li {
    font-size: 13px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--moss);
  }
</style>
