---
import { t, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang).sustainability;
const icons = [
  'M12 2v6m0 8v6M4.9 4.9l4.2 4.2m5.8 5.8 4.2 4.2M2 12h6m8 0h6M4.9 19.1l4.2-4.2m5.8-5.8 4.2-4.2',
  'M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4',
  'M12 21s-8-4.5-8-11a5 5 0 0 1 8-4 5 5 0 0 1 8 4c0 6.5-8 11-8 11Z',
];
---
<section id="sustainability" class="sus">
  <div class="ring" aria-hidden="true" data-parallax="0.12"></div>
  <div class="container grid">
    <div>
      <span class="label" data-reveal>{d.label}</span>
      <h2 class="h2" data-reveal style="--i:1">{d.title}</h2>
      <p class="body" data-reveal style="--i:2">{d.body}</p>
    </div>
    <ul>
      {d.points.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d={icons[i]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{p}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sus { position: relative; overflow: hidden; padding: clamp(96px, 14vw, 180px) 0; background: var(--forest); color: var(--paper); }
  .sus :global(.label) { color: var(--leaf); }
  .ring { position: absolute; right: -15vw; top: -10vw; width: 60vw; aspect-ratio: 1; border-radius: 50%; border: 1px solid rgb(166 220 92 / .25); box-shadow: inset 0 0 0 6vw rgb(166 220 92 / .04), 0 0 0 6vw rgb(166 220 92 / .03); }
  .grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .body { color: rgb(245 242 234 / .75); font-size: clamp(16px, 1.4vw, 19px); margin: 24px 0 0; max-width: 480px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  li { display: flex; align-items: center; gap: 20px; padding: 26px 28px; border-radius: var(--radius); background: rgb(245 242 234 / .06); border: 1px solid rgb(245 242 234 / .1); font-size: clamp(17px, 1.6vw, 21px); font-weight: 500; transition: background .5s var(--ease), transform .5s var(--ease); }
  li:hover { background: rgb(166 220 92 / .14); transform: translateX(8px); }
  svg { color: var(--leaf); flex: none; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
