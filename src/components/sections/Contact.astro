---
import { t, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang).contact;
const EMAIL = 'contact@example.com'; // TODO: 실제 문의 메일
---
<section id="contact" class="contact">
  <div class="container box" data-reveal>
    <h2 class="h2">{d.title}</h2>
    <p>{d.body}</p>
    <a class="btn" href={`mailto:${EMAIL}`}>{d.cta} <span class="arrow">→</span></a>
  </div>
</section>
<style>
  .contact { padding: 0 0 clamp(80px, 10vw, 140px); }
  .box { position: relative; overflow: hidden; border-radius: calc(var(--radius) * 1.5); padding: clamp(48px, 8vw, 110px) clamp(24px, 6vw, 90px); color: var(--paper); text-align: center; display: grid; justify-items: center;
    background: radial-gradient(60% 80% at 15% 0%, rgb(166 220 92 / .5), transparent 60%), radial-gradient(60% 80% at 100% 100%, rgb(31 111 139 / .55), transparent 60%), var(--forest); }
  .h2 { max-width: 900px; margin: 0; }
  p { color: rgb(245 242 234 / .75); margin: 20px 0 36px; }
</style>
