---
import type { Lang } from '../../config/site';
import { useT } from '../../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const points = [t('home.eco.p1'), t('home.eco.p2'), t('home.eco.p3')];
const icons = [
  'M12 2.7C8 7 6 10.4 6 13.5a6 6 0 0 0 12 0c0-3.1-2-6.5-6-10.8Z',
  'M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3M18 3v4h-4M6 21v-4h4',
  'M12 21s-8-4.5-8-11a5 5 0 0 1 8-4 5 5 0 0 1 8 4c0 6.5-8 11-8 11Z',
];
---

<section class="eco">
  <div class="ring" aria-hidden="true" data-parallax="0.12"></div>
  <div class="container grid">
    <div>
      <span class="label" data-reveal>{t('home.eco.label')}</span>
      <h2 class="h2" data-reveal style="--i:1">{t('home.eco.title')}</h2>
      <p class="body" data-reveal style="--i:2">{t('home.eco.body')}</p>
    </div>
    <ul>
      {
        points.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
              <path d={icons[i]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .eco {
    position: relative;
    overflow: hidden;
    padding: clamp(96px, 14vw, 180px) 0;
    background: var(--forest);
    color: var(--paper);
  }
  .eco .label {
    color: var(--leaf);
  }
  .ring {
    position: absolute;
    right: -15vw;
    top: -10vw;
    width: 60vw;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgb(166 220 92 / 0.25);
    box-shadow:
      inset 0 0 0 6vw rgb(166 220 92 / 0.04),
      0 0 0 6vw rgb(166 220 92 / 0.03);
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .h2 {
    margin-top: 6px;
  }
  .body {
    color: rgb(245 242 234 / 0.75);
    font-size: clamp(16px, 1.4vw, 19px);
    margin: 24px 0 0;
    max-width: 480px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 26px 28px;
    border-radius: var(--radius);
    background: rgb(245 242 234 / 0.06);
    border: 1px solid rgb(245 242 234 / 0.1);
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 500;
    transition:
      background 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  li:hover {
    background: rgb(166 220 92 / 0.14);
    transform: translateX(8px);
  }
  svg {
    color: var(--leaf);
    flex: none;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
