---
import { t, type Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const words = t(lang).marquee;
---
<div class="marquee" aria-hidden="true">
  <div class="track">
    {[0, 1].map(() => words.map((w) => <span>{w}<i>✦</i></span>))}
  </div>
</div>
<style>
  .marquee { background: var(--leaf); color: var(--forest); overflow: hidden; padding: 22px 0; }
  .track { display: flex; width: max-content; animation: slide 30s linear infinite; }
  span { display: inline-flex; align-items: center; gap: 36px; padding-right: 36px; font-size: clamp(22px, 3vw, 40px); font-weight: 700; letter-spacing: -0.02em; white-space: nowrap; }
  i { font-style: normal; font-size: .6em; }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
