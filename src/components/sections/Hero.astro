---
import { Image } from 'astro:assets';
import type { Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
import { href } from '../../i18n/utils';
import { STORY } from '../../config/story';
import wood from '../../assets/materials/wood.png';
import fabric from '../../assets/materials/fabric.png';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const lines = t('home.title').split('\n');
---
<section class="hero">
  <div class="container hero-grid">
    <div class="content">
      <p class="eyebrow" data-reveal>{t('home.eyebrow')}</p>
      <h1 data-reveal style="--i:1">{lines.map((line) => <span>{line}</span>)}</h1>
      <p class="lead" data-reveal style="--i:2">{t('home.lead')}</p>
      <div class="actions" data-reveal style="--i:3"><a class="editorial-link" href={href(lang, '/products')}>{t('home.cta.products')} <span aria-hidden="true">↗</span></a><a class="secondary" href={href(lang, '/about')}>{t('nav.about')}</a></div>
    </div>
    <div class="materials" aria-hidden="true" data-reveal="image">
      <Image class="oak" src={wood} alt="" width={850} height={880} fit="cover" format="webp" loading="eager" fetchpriority="high" />
      <Image class="textile" src={fabric} alt="" width={400} height={460} fit="cover" format="webp" loading="eager" />
      <span class="material-caption">HIVINA / MATERIAL STUDIES</span>
    </div>
  </div>
  <div class="container footnote"><span>LPM · FINISHING FOIL</span><a href={href(lang, '/about')}>{STORY[lang].locationValue} <span aria-hidden="true">↗</span></a></div>
</section>
<style>
  .hero { background: #f5f4ef; padding-top: 40px; color: var(--ink); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 84px); align-items: center; }
  .content { padding-block: 20px; }
  .eyebrow { font-size: 10px; letter-spacing: .12em; margin-bottom: 20px; }
  h1 { font-size: clamp(34px, 3.75vw, 54px); line-height: 1.25; letter-spacing: -.045em; font-weight: 500; margin: 0; }
  h1 > span { display: block; }
  .lead { font-size: 14px; line-height: 1.95; max-width: 43ch; margin: 24px 0; color: var(--ink-soft); }
  .actions { display: flex; gap: 28px; align-items: center; }
  .secondary { text-decoration: none; font-size: 12px; color: var(--ink-soft); }
  .materials { position: relative; height: clamp(300px, 34vw, 440px); }
  .oak { position: absolute; width: 78%; height: 94%; right: 0; top: 0; object-fit: cover; }
  .textile { position: absolute; width: 40%; height: 58%; left: 0; bottom: 0; object-fit: cover; }
  .material-caption { position: absolute; left: 0; top: 8px; writing-mode: vertical-rl; font-size: 9px; letter-spacing: .12em; color: #657167; }
  .footnote { display: flex; justify-content: space-between; gap: 24px; padding-block: 24px; margin-top: 20px; font-size: 10px; letter-spacing: .1em; }
  .footnote a { text-decoration: none; color: var(--ink-soft); letter-spacing: .02em; }
  @media (max-width: 760px) {
    .hero { padding-top: 24px; }
    .hero-grid { grid-template-columns: 1fr; gap: 26px; }
    h1 { font-size: 36px; }
    .content { padding-block: 8px; }
    .materials { height: 280px; }
    .footnote { margin-top: 8px; }
  }
</style>
