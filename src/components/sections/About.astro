---
import CompanyPhoto from '../CompanyPhoto.astro';
import { COMPANY, type Lang } from '../../config/site';
import { STORY } from '../../config/story';
import { useT } from '../../i18n/ui';
import { href } from '../../i18n/utils';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const s = STORY[lang];
const milestones = [
  { year: COMPANY.rootsYear, label: t('home.stat.roots') },
  { year: COMPANY.founded, label: t('home.stat.founded') },
  { year: COMPANY.productionStart, label: t('home.stat.production') },
];
---
<section class="about" aria-labelledby="home-about-title">
  <div class="container">
    <div class="section-index" data-reveal><span>01 / ABOUT HI VINA</span><span>HYOSAN · ICC · VIETNAM</span></div>
    <div class="about-grid">
      <figure data-reveal="image"><CompanyPhoto alt={s.photo} /><figcaption>HI VINA JSC <span>Đồng Nai, Việt Nam</span></figcaption></figure>
      <div class="copy"><h2 id="home-about-title" data-reveal>{s.title}</h2><p data-reveal style="--i:1">{t('about.body')}</p><a class="editorial-link" href={href(lang, '/about')} data-reveal style="--i:2">{t('home.about.more')} <span aria-hidden="true">↗</span></a></div>
    </div>
    <ol class="milestones">{milestones.map((item) => <li data-reveal><span class="year">{item.year}</span><span>{item.label}</span></li>)}</ol>
  </div>
</section>
<style>
  .about { padding-block: clamp(48px, 6vw, 80px); background: #f5f4ef; }
  .section-index { display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid var(--color-line); padding-top: 16px; font-size: 10px; letter-spacing: .12em; color: var(--ink-soft); }
  .about-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 7vw, 96px); align-items: center; padding-block: 36px; }
  figure { margin: 0; }
  figcaption { display: flex; justify-content: space-between; font-size: 10px; padding-top: 10px; color: var(--ink-soft); }
  h2 { font-size: clamp(28px, 2.8vw, 40px); font-weight: 500; line-height: 1.4; letter-spacing: -.035em; white-space: pre-line; margin-bottom: 20px; }
  .copy p { font-size: 14px; line-height: 1.95; color: var(--ink-soft); max-width: 48ch; margin-bottom: 24px; }
  .milestones { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-block: 1px solid var(--color-line); }
  .milestones li { display: flex; gap: 18px; align-items: center; padding: 22px 20px; font-size: 11px; color: var(--ink-soft); }
  .milestones li:first-child { padding-left: 0; }
  .milestones li + li { border-left: 1px solid var(--color-line); }
  .year { font-size: 26px; font-weight: 400; letter-spacing: -.035em; color: var(--forest); }
  @media (max-width: 760px) {
    .section-index > span:last-child { display: none; }
    .about-grid { grid-template-columns: 1fr; gap: 28px; }
    figure { max-width: 520px; }
    .copy p { max-width: none; }
    .milestones { grid-template-columns: 1fr; }
    .milestones li, .milestones li:first-child { padding: 14px 0; }
    .milestones li + li { border-left: 0; border-top: 1px solid var(--color-line); }
  }
</style>
