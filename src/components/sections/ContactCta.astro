---
import type { Lang } from '../../config/site';
import { useT } from '../../i18n/ui';
import { href } from '../../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---

<section class="contact">
  <div class="container">
    <div class="box" data-reveal>
      <h2 class="h2">{t('home.contact.title')}</h2>
      <p>{t('home.contact.body')}</p>
      <a class="btn btn--leaf" href={href(lang, '/contact')}>{t('home.cta.contact')} <span class="arrow">→</span></a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 0 0 clamp(48px, 6vw, 80px);
  }
  .box {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    border-block: 1px solid var(--color-line);
    padding: 40px 0;
    color: var(--ink);
    text-align: left;
    display: grid;
    justify-items: start;
    background: transparent;
  }
  .h2 {
    max-width: 900px;
  }
  p {
    color: var(--ink-soft);
    margin: 14px 0 24px;
  }
</style>
