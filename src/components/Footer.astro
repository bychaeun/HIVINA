---
import Logo from './Logo.astro';
import { COMPANY,type Lang } from '../config/site';
import { COPY } from '../data/website';
import { href } from '../i18n/utils';
const {lang}=Astro.props as {lang:Lang};const c=COPY[lang];
---
<footer class="site-footer"><div class="container footer-grid"><div class="footer-company"><a class="footer-logo" href={href(lang)} aria-label="HIVINA"><Logo id="footer-logo" height={25}/></a><a class="footer-phone" href="tel:+842513686731">0251 3686 731</a><p>Lot 03, Road No. 4, Giang Dien Industrial Park, Trang Bom Ward, Dong Nai City, Vietnam</p><a class="footer-email" href="mailto:hivina0835@gmail.com">hivina0835@gmail.com</a></div><nav aria-label={c.about}><a href={href(lang,'/about')}>{c.about}</a><a href={href(lang,'/products')}>{c.products}</a><a href={href(lang,'/projects')}>{c.projects}</a><a href={href(lang,'/news')}>{c.news}</a><a href={href(lang,'/contact')}>{c.contact}</a><a href={href(lang,'/catalogue')}>{c.catalogue}</a></nav><div class="socials"><a href={COMPANY.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href="https://www.linkedin.com/company/hivina/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://www.instagram.com/hivina.melaminepaper/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="https://maps.app.goo.gl/PLJTpMj8hBYbxcjr5?g_st=ic" target="_blank" rel="noopener noreferrer">Factory ↗</a></div></div><div class="container footer-bottom"><span>© 2026. Hi Viet Nam Joint Stock Company.</span><span>HYOSAN · ICC · HIVINA</span></div></footer>
<style>
.site-footer{--logo-text:#fff;background:#202c25;color:rgb(255 255 255 / .7);padding:56px 0 20px;font-size:11px;}.footer-grid{display:grid;grid-template-columns:1.7fr .7fr .7fr;gap:70px;}.footer-logo{display:inline-block;margin-bottom:28px;}.footer-phone{display:block;font-size:20px;color:white;text-decoration:none;margin-bottom:16px;}.footer-company p{max-width:42ch;line-height:1.9;margin:0 0 12px;}.footer-email{color:inherit;text-decoration:none;}.footer-grid nav,.socials{display:flex;flex-direction:column;gap:13px;align-items:start;padding-top:6px;}.footer-grid nav a,.socials a{text-decoration:none;}.footer-grid a:hover{color:white;}.footer-bottom{display:flex;justify-content:space-between;gap:24px;border-top:1px solid rgb(255 255 255 / .13);padding-top:20px;margin-top:42px;font-size:9px;color:rgb(255 255 255 / .45);}@media(max-width:760px){.footer-grid{grid-template-columns:1fr 1fr;gap:32px;}.footer-company{grid-column:1 / -1;}.footer-bottom{flex-direction:column;gap:8px;}}
</style>
